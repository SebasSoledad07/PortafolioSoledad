---
const email = "soledadsebastian07@gmail.com";

const whatsappNumber = "+573243106287";
const whatsappMessage =
  "Hola Sebastián, vi tu portafolio y quiero hablar sobre un proyecto.";

const whatsappUrl = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : undefined;

const socials = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/sebastiansoledad/",
    icon: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z",
  },
  {
    label: "GitHub",
    url: "https://github.com/SebasSoledad07",
    icon: "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
  },
];
---

<section id="contacto" class="section py-28">
  <div class="container-page">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <p class="eyebrow">// Contacto</p>

      <h2
        class="mt-4 font-black text-ink"
        style="font-size: clamp(34px, 6vw, 72px); line-height: 1.02;"
      >
        ¿Tienes un proyecto? <span class="text-accent">Hablemos.</span>
      </h2>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-body">
        Cuéntame qué necesitas y te respondo en menos de 24 horas. Estoy abierto
        a proyectos freelance y a oportunidades de trabajo.
      </p>

      <div
        class="mt-10 flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-center"
      >
        <a
          href={`mailto:${email}`}
          class="btn btn-primary w-full gap-2.5 normal-case tracking-normal sm:w-auto"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m2 7 10 6 10-6"></path>
          </svg>
          {email}
        </a>

        {
          whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline w-full gap-2.5 sm:w-auto"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" />
              </svg>
              WhatsApp
            </a>
          )
        }

        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline w-full gap-2.5 sm:w-auto"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={social.icon} />
              </svg>
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
