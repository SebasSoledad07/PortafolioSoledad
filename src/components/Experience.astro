---
import { getCopy, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const c = getCopy(lang).experience;
---

<section id="experiencia" class="section relative">
  <div class="container-page">
    
    <div class="mb-16">
      <h2 class="font-mono text-xs text-accent uppercase tracking-[0.5em] mb-4">{c.eyebrow}</h2>
      <h3 class="text-4xl md:text-5xl font-black text-ink">{c.titleLead}<span class="text-accent">{c.titleAccent}</span></h3>
    </div>

    <div class="relative border-l border-line ml-2 md:ml-8 pl-6 md:pl-8 space-y-12">
      {c.items.map((exp) => (
        <div class="relative">
          <div
            class:list={[
              "absolute -left-[33px] top-1 h-4 w-4 rounded-full border-2 md:-left-[41px]",
              exp.current
                ? "border-accent bg-accent shadow-[0_0_12px_rgba(0,229,255,0.6)]"
                : "border-accent/60 bg-bg",
            ]}
            aria-hidden="true"
          ></div>
          
          <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between mb-4">
            <div>
              <h4 class="text-xl font-bold text-ink transition-colors">
                {exp.role}
              </h4>
              <p class="text-accent font-mono text-sm">{exp.company}</p>
            </div>
            <span class="inline-flex w-fit font-mono text-[13px] text-[#D8D8DE] uppercase tracking-widest bg-surface-2 px-3 py-1">
              {exp.date}
            </span>
          </div>

          <p class="text-ink-body text-sm max-w-3xl leading-relaxed mb-6">
            {exp.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {exp.highlights.map((item) => (
              <span class="chip">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20">
      <div class="mb-8">
        <h2 class="mb-4 font-mono text-xs uppercase tracking-[0.5em] text-accent">
          {c.certifications.eyebrow}
        </h2>
        <h3 class="text-3xl font-black text-ink md:text-4xl">
          {c.certifications.titleLead}<span class="text-accent">{c.certifications.titleAccent}</span>
        </h3>
      </div>

      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {
          c.certifications.items.map((certification) => (
            <li class="card p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-xs uppercase tracking-widest text-accent">
                  {certification.issuer}
                </span>
                <span class="font-mono text-xs text-ink-meta">
                  {certification.year}
                </span>
              </div>
              <h4 class="mt-3 text-base leading-snug font-bold text-ink">
                {certification.title}
              </h4>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
