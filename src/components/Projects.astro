---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="section bg-bg">
  <div class="container-page">
    
    <div class="mb-12 md:mb-16 text-center md:text-left">
      <h2 class="font-mono text-accent text-xs uppercase tracking-[0.4em] mb-2">// Portafolio</h2>
      <h3 class="text-3xl md:text-5xl font-black text-ink">Proyectos <span class="text-accent">Destacados</span></h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>