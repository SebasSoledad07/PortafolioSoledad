---
import { techIcons, conceptIcon } from "../data/tech-icons";
import { getCopy, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const c = getCopy(lang).hero;

const stack = [
  "Java",
  "Spring Boot",
  "React",
  "Angular",
  "PostgreSQL",
  "Docker",
];
---

<section
  id="inicio"
  class="relative flex min-h-[100svh] items-center overflow-hidden bg-bg px-6 pb-16 pt-28"
>
  <div class="container-page">
    <div class="text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-success/25 bg-success/10 px-4 py-2 font-mono text-xs uppercase tracking-[0.15em] text-ink-body"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-success"
          ></span>
        </span>
        {c.availability}
      </p>

      <h1
        class="mt-8 font-black whitespace-nowrap text-ink"
        style="font-size: clamp(2.25rem, 10.5vw, 9rem); line-height: 0.88;"
      >
        Soledad<span class="text-accent">.dev</span>
      </h1>

      <p
        class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-ink-body md:text-lg"
      >
        {c.subtitlePre}<strong class="font-semibold text-ink"
          >{c.subtitleStrong}</strong
        >{c.subtitlePost}
      </p>

      <div
        class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a href="#proyectos" class="btn btn-primary w-full sm:w-auto">
          {c.primaryCta}
        </a>
        <a
          href="/SEBASTIAN_SOLEDAD_CV.pdf"
          class="btn btn-outline w-full sm:w-auto"
        >
          {c.cvCta}
        </a>
      </div>

      <div class="mx-auto mt-14 max-w-3xl border-t border-line-soft pt-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-meta">
          {c.stackLabel}
        </p>
        <ul class="mt-4 flex flex-wrap justify-center gap-2">
          {
            stack.map((tech) => (
              <li class="chip gap-2">
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={techIcons[tech] ?? conceptIcon} />
                </svg>
                {tech}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
