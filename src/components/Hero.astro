---
const stack = [
  "Java",
  "Spring Boot",
  "React",
  "Angular",
  "PostgreSQL",
  "Docker",
];
---

<section
  id="inicio"
  class="relative flex min-h-[100svh] items-center overflow-hidden bg-bg px-6 pb-16 pt-28"
>
  <div class="container-page">
    <div class="mx-auto max-w-4xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-success/25 bg-success/10 px-4 py-2 font-mono text-xs uppercase tracking-[0.15em] text-ink-body"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-success"
          ></span>
        </span>
        Disponible para proyectos · Cúcuta, COL
      </p>

      <h1
        class="mt-8 font-black text-ink"
        style="font-size: clamp(3rem, 12vw, 9.5rem); line-height: 0.88;"
      >
        Soledad<span class="text-accent">.dev</span>
      </h1>

      <p
        class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-ink-body md:text-lg"
      >
        Ingeniero de sistemas que construye aplicaciones
        <strong class="font-semibold text-ink"
          >fullstack con Java, Spring Boot y React</strong
        >: reservas, alquileres y gestión académica, de la base de datos a la
        interfaz.
      </p>

      <div
        class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a href="#proyectos" class="btn btn-primary w-full sm:w-auto">
          Ver proyectos ↗
        </a>
        <a
          href="/SEBASTIAN_SOLEDAD_CV.pdf"
          class="btn btn-outline w-full sm:w-auto"
        >
          Descargar CV
        </a>
      </div>

      <div class="mt-14 border-t border-line-soft pt-6">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-meta">
          Stack diario
        </p>
        <ul class="mt-4 flex flex-wrap justify-center gap-2">
          {stack.map((tech) => <li class="chip">{tech}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
