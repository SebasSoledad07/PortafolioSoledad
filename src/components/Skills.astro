---
import { techIcons, conceptIcon } from "../data/tech-icons";
import { getCopy, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const c = getCopy(lang).skills;

/**
 * Un ícono distinto por tarjeta: servidor (backend), navegador (frontend),
 * base de datos (data), nube (devops) y terminal (metodología/IA).
 * SVG 24×24, trazo con `currentColor`.
 */
const categoryIcons: string[][] = [
  [
    "M4 3h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z",
    "M4 14h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z",
    "M6 6.5h.01",
    "M6 17.5h.01",
  ],
  [
    "M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5Z",
    "M2 9h20",
    "M5 6.5h.01",
    "M8 6.5h.01",
  ],
  [
    "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
  ],
  ["M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"],
  ["M4 17l6-6-6-6", "M12 19h8"],
];
---

<section id="stack" class="section relative overflow-hidden bg-bg">
  <div class="container-page relative z-10">
    
    <div class="mb-16">
      <h2 class="text-xs font-mono text-accent uppercase tracking-[0.5em] mb-4">
        {c.eyebrow}
      </h2>
      <h3 class="text-4xl md:text-5xl font-black text-ink tracking-tight">
        {c.titleLead}<span class="text-accent">{c.titleAccent}</span>
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {c.categories.map((category, index) => (
        <div
          class:list={[
            "card card-hover group p-8 hover:border-accent/40",
            index === 4 && "md:col-span-2",
          ]}
        >
          <div class="flex items-start justify-between mb-6">
            <div class="grid h-12 w-12 place-items-center bg-accent/5 rounded-lg border border-accent/10 group-hover:bg-accent/20 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                {categoryIcons[index].map((path) => (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={path} />
                ))}
              </svg>
            </div>
            <span class="font-mono text-xs text-ink-meta group-hover:text-accent transition-colors uppercase tracking-widest">
              0{index + 1}
            </span>
          </div>

          <h4 class="text-2xl font-bold text-ink mb-2 group-hover:text-accent transition-colors uppercase">
            {category.title}
          </h4>
          <p class="text-ink-body text-sm mb-8">
            {category.description}
          </p>

          <div class="flex flex-wrap gap-3">
            {category.skills.map((skill) => (
              <span class="chip cursor-default gap-2 px-3 py-[7px] text-[13px] transition-all hover:border-accent/30 hover:text-accent">
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={techIcons[skill] ?? conceptIcon} />
                </svg>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Ajuste del gradiente para usar la variable de v4 */
  #stack::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 140%;
    height: 140%;
    background: radial-gradient(circle at center, var(--color-accent) 0.03, transparent 70%);
    opacity: 0.05;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
</style>
