---
import { getCopy, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const c = getCopy(lang).footer;

const currentYear = new Date().getFullYear();

const socials = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/sebastiansoledad/",
  },
  {
    label: "GitHub",
    url: "https://github.com/SebasSoledad07",
  },
  {
    label: "Instagram",
    url: "https://www.instagram.com/soledads.dev/",
  },
];
---

<footer class="border-t border-line-soft bg-bg py-12">
  <div class="container-page">
    <div
      class="flex flex-col items-center gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div class="text-center md:text-left">
        <p
          class="font-display text-lg font-black uppercase tracking-tight text-ink"
        >
          Soledad<span class="text-accent">.dev</span>
        </p>
        <div
          class="mt-3 flex items-center justify-center gap-2 md:justify-start"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-success"
            ></span>
          </span>
          <p
            class="font-mono text-xs uppercase tracking-widest text-ink-nav"
          >
            {c.status}
          </p>
        </div>
      </div>

      <nav
        aria-label={c.socialLabel}
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1"
      >
        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center font-mono text-xs uppercase tracking-widest text-ink-nav transition-colors hover:text-accent"
            >
              {social.label}
            </a>
          ))
        }
      </nav>

      <div class="text-center md:text-right">
        <p class="font-mono text-xs uppercase tracking-widest text-ink-nav">
          &copy; {currentYear} Sebastian Soledad
        </p>
        <p class="mt-1 font-mono text-xs text-ink-nav">
          {c.madeWith}
        </p>
      </div>
    </div>
  </div>
</footer>
