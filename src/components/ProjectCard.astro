---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import { getCopy, type Lang } from "../i18n";

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = "es" } = Astro.props;
const c = getCopy(lang).projects.card;

const { title, stack, demoUrl, repoUrl, image, video, videoType, poster } =
  project;
const category = project.category[lang];
const description = project.description[lang];
const result = project.highlight?.[lang];
const imageAlt = project.imageAlt?.[lang];

const initials = title
  .split(" ")
  .map((word) => word[0])
  .slice(0, 2)
  .join("");
---

<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <div class="relative h-[210px] shrink-0 border-b border-line bg-preview-bg">
    <div
      class="flex items-center gap-1.5 border-b border-line-soft px-4 py-3"
      aria-hidden="true"
    >
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="h-2 w-2 rounded-full bg-line"></span>
      <span class="ml-2 font-mono text-xs uppercase tracking-widest text-ink-meta">
        {c.preview}
      </span>
    </div>

    {
      video ? (
        <video
          class="h-[calc(100%-41px)] w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster?.src}
          aria-label={`${c.videoAltPrefix} ${title}`}
          data-reduced-motion
        >
          <source src={video} type={videoType ?? "video/mp4"} />
        </video>
      ) : image ? (
        <Image
          class="h-[calc(100%-41px)] w-full object-cover"
          src={image}
          alt={imageAlt ?? `${c.imageAltPrefix} ${title}`}
          widths={[600, 1200]}
          sizes="(min-width: 768px) 33vw, 100vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="relative flex h-[calc(100%-41px)] items-center justify-center overflow-hidden">
          <div
            class="absolute inset-0 opacity-20"
            style="background-image: linear-gradient(var(--color-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-line) 1px, transparent 1px); background-size: 32px 32px;"
            aria-hidden="true"
          >
          </div>
          <div class="relative flex flex-col items-center gap-3" aria-hidden="true">
            <span class="grid h-16 w-16 place-items-center rounded-lg border border-accent/30 bg-surface-2 font-display text-xl font-black text-accent">
              {initials}
            </span>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-ink-meta">
              {c.placeholder}
            </span>
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6">
    <span class="font-mono text-xs uppercase tracking-widest text-accent">
      {category}
    </span>
    <h3 class="mt-2 text-xl font-bold uppercase text-ink transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-body">
      {description}
    </p>

    {
      result && (
        <p class="mt-4 border-t border-dashed border-line pt-3 text-sm text-ink-meta">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-accent">
            {c.highlight}
          </span>{" "}
          · {result}
        </p>
      )
    }

    <div class="mt-5 flex flex-wrap gap-2">
      {stack.map((tech) => <span class="chip">{tech}</span>)}
    </div>

    {
      (demoUrl || repoUrl) && (
        <div class="mt-auto flex flex-wrap gap-3 pt-6">
          {demoUrl && (
            <a
              class="btn btn-primary btn-card"
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {c.demo}
            </a>
          )}
          {repoUrl && (
            <a
              class="btn btn-outline btn-card btn-card-outline"
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {c.code}
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  document
    .querySelectorAll<HTMLVideoElement>("video[data-reduced-motion]")
    .forEach((video) => {
      if (prefersReducedMotion.matches) {
        video.removeAttribute("autoplay");
        video.pause();
        video.currentTime = 0;
      }
    });
</script>
