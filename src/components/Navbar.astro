---
const navItems = [
  { name: 'Inicio', href: '#home' },
  { name: 'Experiencia', href: '#experience' },
  { name: 'Habilidades', href: '#skills' },
  { name: 'Proyectos', href: '#projects' },
  { name: 'Contacto', href: '#contact' },
];
---

<nav class="fixed top-0 w-full z-50 transition-all duration-300 border-b border-cyanElectric/10 bg-carbon/80 backdrop-blur-md" id="main-nav">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <div class="flex items-center">
      <a href="/" class="group">
        <h1 class="text-2xl font-sans font-extrabold tracking-tighter text-smoke">
          Soledad<span class="text-cyanElectric transition-all duration-300 group-hover:drop-shadow-[0_0_8px_#00E5FF]">.dev</span>
        </h1>
      </a>
    </div>

    <div class="hidden md:flex items-center space-x-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="font-mono text-xs uppercase tracking-widest text-smoke/70 hover:text-cyanElectric transition-colors duration-200"
        >
          <span class="text-cyanElectric/50 mr-1">//</span> {item.name}
        </a>
      ))}
      
      <a 
        href="/cv.pdf" 
        target="_blank"
        class="font-mono text-[10px] uppercase tracking-[0.2em] border border-cyanElectric px-4 py-2 hover:bg-cyanElectric hover:text-carbon transition-all duration-300 shadow-[0_0_15px_rgba(0,229,255,0.1)]"
      >
        Get_CV
      </a>
    </div>

    <button class="md:hidden text-cyanElectric p-2" id="menu-toggle" aria-label="Abrir menú">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden absolute w-full bg-carbon border-b border-cyanElectric/20 px-6 py-8 flex flex-col space-y-6">
    {navItems.map((item) => (
      <a href={item.href} class="font-mono text-sm text-smoke hover:text-cyanElectric">
        <span class="text-cyanElectric">0{navItems.indexOf(item) + 1}.</span> {item.name}
      </a>
    ))}
  </div>
</nav>

<script>
  // Simple logic for scroll effect and mobile toggle
  const nav = document.getElementById('main-nav');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('h-16');
      nav?.classList.remove('h-20');
    } else {
      nav?.classList.add('h-20');
      nav?.classList.remove('h-16');
    }
  });

  toggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>