---
import { getCopy, homePath, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const c = getCopy(lang).nav;
---

<nav
  id="main-nav"
  aria-label={c.aria}
  class="fixed top-0 z-50 w-full border-b border-line-soft bg-bg/80 backdrop-blur-md transition-shadow duration-300"
>
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4">
      <a
        href={homePath(lang)}
        class="font-display text-lg font-black whitespace-nowrap uppercase tracking-tight text-ink"
      >
        Soledad<span class="text-accent">.dev</span>
      </a>

      <div class="flex items-center gap-3 xl:gap-4">
        <ul class="hidden items-center gap-4 xl:flex 2xl:gap-5">
          {
            c.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="inline-flex min-h-11 items-center font-mono text-xs whitespace-nowrap uppercase tracking-widest text-ink-nav transition-colors hover:text-accent"
                >
                  // {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="flex items-center font-mono text-xs uppercase tracking-widest"
          role="group"
          aria-label={c.language}
        >
          <a
            href="/"
            hreflang="es"
            lang="es"
            aria-current={lang === "es" ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center px-1.5 transition-colors",
              lang === "es" ? "text-accent" : "text-ink-nav hover:text-accent",
            ]}
          >
            ES
          </a>
          <span class="px-1 text-line" aria-hidden="true">/</span>
          <a
            href="/en/"
            hreflang="en"
            lang="en"
            aria-current={lang === "en" ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 items-center px-1.5 transition-colors",
              lang === "en" ? "text-accent" : "text-ink-nav hover:text-accent",
            ]}
          >
            EN
          </a>
        </div>

        <a
          href="/SEBASTIAN_SOLEDAD_CV.pdf"
          class="btn btn-outline btn-card hidden px-4 xl:inline-flex"
        >
          {c.cv}
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded border border-line text-ink-nav transition-colors hover:border-accent hover:text-accent xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={c.menuOpen}
          data-open-label={c.menuOpen}
          data-close-label={c.menuClose}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-line-soft bg-bg xl:hidden"
  >
    <div class="container-page py-4">
      <ul class="flex flex-col gap-1">
        {
          c.items.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                class="flex min-h-11 items-center font-mono text-xs whitespace-nowrap uppercase tracking-widest text-ink-nav transition-colors hover:text-accent"
              >
                // {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2">
          <a
            href="/SEBASTIAN_SOLEDAD_CV.pdf"
            class="btn btn-outline btn-card w-full"
          >
            {c.cv}
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  const toggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  const openLabel = toggle?.dataset.openLabel ?? "Abrir menú";
  const closeLabel = toggle?.dataset.closeLabel ?? "Cerrar menú";

  const setMenu = (open: boolean) => {
    if (!toggle || !mobileMenu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
    mobileMenu.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setMenu(!isOpen);
  });

  mobileMenu
    ?.querySelectorAll<HTMLAnchorElement>("a")
    .forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("#main-nav a[data-nav-link]"),
  ];
  const sections = [
    ...document.querySelectorAll<HTMLElement>("main section[id]"),
  ];

  const setActive = (activeId: string | undefined) => {
    links.forEach((link) => {
      const isActive = activeId
        ? link.getAttribute("href") === `#${activeId}`
        : false;
      link.classList.toggle("text-accent", isActive);
      link.classList.toggle("text-ink-nav", !isActive);
      if (isActive) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        const active = sections.find((section) => visible.has(section.id));
        setActive(active?.id);
      },
      { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  }

  window.addEventListener(
    "scroll",
    () => {
      nav?.classList.toggle(
        "shadow-[0_8px_24px_rgba(0,0,0,0.35)]",
        window.scrollY > 8,
      );
    },
    { passive: true },
  );
</script>
